<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Chat IA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="card-container">
    <div class="card-header">
      <div class="img-avatar"></div>
      <div class="text-chat">Chat</div>
    </div>
    <div class="card-body">
      <div class="messages-container" id="messages"></div>
      <div class="message-input">
        <form id="chat-form">
          <textarea placeholder="Escribe tu mensaje" class="message-send" id="message"></textarea>
          <button class="learn-more" type="submit">Enviar</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    window.__SERVICE_KEY__ = "<%= serviceKey %>";
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/client.js"></script>
</body>
</html>
